# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.java text diff=java eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.properties text eol=lf

# Shell scripts must have LF line endings to run on UNIX/containers
*.sh text eol=lf
mvnw text eol=lf

# Windows batch files must retain CRLF line endings
*.cmd text eol=crlf
*.bat text eol=crlf
mvnw.cmd text eol=crlf

# Binary files
*.jar binary
*.war binary
*.zip binary
*.tar.gz binary
*.ico binary
*.png binary
*.jpg binary
