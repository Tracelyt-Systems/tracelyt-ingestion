# Tracelyt Ingestion - Environment Configuration Template
# Copy this file to .env for local runtime overrides (never commit real .env files to Git)

# ==============================================================================
# 1. Active Foundation Settings (Currently Used)
# ==============================================================================
# HTTP service listening port for operational Actuator probes
PORT=8081
SPRING_PROFILES_ACTIVE=default

# Operational management endpoints exposure (comma-separated list)
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info

# ==============================================================================
# 2. Planned Telemetry Ingestion Settings (Reserved for Future Implementation)
# These settings are documented for architectural visibility and are NOT active yet.
# ==============================================================================
# Planned OTLP Receiver Ports
# OTLP_GRPC_PORT=4317
# OTLP_HTTP_PORT=4318

# Planned Resource & Ingestion Limits
# INGESTION_MAX_REQUEST_SIZE_BYTES=4194304
# INGESTION_RATE_LIMIT_REQUESTS_PER_SEC=1000

# Planned Telemetry Pipeline Forwarding (e.g., Kafka / Stream Processors)
# TELEMETRY_PIPELINE_BOOTSTRAP_SERVERS=localhost:9092
# TELEMETRY_INGESTION_TOPIC_TRACES=tracelyt.telemetry.traces.v1
# TELEMETRY_INGESTION_TOPIC_METRICS=tracelyt.telemetry.metrics.v1
# TELEMETRY_INGESTION_TOPIC_LOGS=tracelyt.telemetry.logs.v1

# Planned Ingestion Token Verification (Control Plane Integration)
# CONTROL_PLANE_TOKEN_VERIFY_URL=http://localhost:8080/api/v1/internal/tokens/verify
