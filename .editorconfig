# http://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,xml}]
indent_size = 4

[*.{yml,yaml,json,md}]
indent_size = 2

[*.sh]
indent_style = space
indent_size = 2
end_of_line = lf

[*.{cmd,bat}]
indent_style = space
indent_size = 2
end_of_line = crlf

[Makefile]
indent_style = tab
