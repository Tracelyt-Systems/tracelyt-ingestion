{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Minimal Renovate configuration for Tracelyt Ingestion dependency updates",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": false
    }
  ],
  "dependencyDashboard": true,
  "labels": ["dependencies"]
}
